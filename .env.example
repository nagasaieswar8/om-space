MONGODB_URI=mongodb://127.0.0.1:27017/own_space
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Optional chat and map integrations
GEMINI_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Set these locally before running npm run db:seed. The seed script requires
# all three passwords to be at least 12 characters and never prints them.
SEED_ADMIN_EMAIL=admin@ownspace.local
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.test
SEED_CUSTOMER_PASSWORD=
SEED_AGENCY_EMAIL=agency@example.test
SEED_AGENCY_PASSWORD=
